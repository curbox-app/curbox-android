<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="@string/contributors_title" />

    <TextView
        android:id="@+id/text_contributor_info"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:lineSpacingExtra="4dp"
        android:minLines="2"
        android:text="@string/contributors_intro"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="88dp">

        <neth.iecal.curbox.ui.views.ContributorsCloudView
            android:id="@+id/contributors_cloud"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/contributors_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</LinearLayout>
